<%
let arr = ["0"]
%>
<% if( total == 1) { %>
<!-- <a href="#">0</a> -->
<% } %>

<% if(total > 1) { 
    if(offset>1){
			arr.push("...")
		}
    if(offset > 0 && offset < total-1 ){
        arr.push(String(offset))
    }    
    if(offset < total-2){
			arr.push("...")
		}
    arr.push(String(total-1))
%>
<!-- <a href="#"><%= offset %></a> -->
<% } %>

<div class="wrap-pagination">
  <div class="pagination">
    <ul>
      <li>
        <a href="<%= path %>&limit=<%=limit%>&offset=<%= offset > 0 ? offset-1 : 0 %>" class="<%=offset > 0 ? '':'disable' %>">Trang trước</a>
      </li>
      <% for(index in arr){ %>
      <% if(arr[index]==="..."){ %>
      <li>
        <a class="<%= arr[index]==offset ? 'current' :'' %>" href="#"><%= arr[index] %></a>
      </li>
      <% }else{ %>
      <li>
        <a class="<%= arr[index]==offset ? 'current' :'' %>" href="<%= path %>&limit=<%=limit%>&offset=<%= arr[index] %>"><%= arr[index] %></a>
      </li>
      <% } } %>
      <li><a href="<%= path %>&limit=<%=limit%>&offset=<%= offset < total-1 ? offset+1 : total-1 %>" class="<%= offset < total-1 ? '':'disable' %>">Trang sau</a></li>
    </ul>
  </div>
</div>