<%
let arr = ["0"]
%>
<% if( total == 1) { %>
<!-- <a href="#">0</a> -->
<% } %>

<% if(total > 1) { 
    if(offset>limit){
			arr.push("...")
		}
    if(offset >= limit && offset < (total-1)*limit ){
        arr.push(String(offset/limit))
    }    
    if(offset < (total-2)*limit){
			arr.push("...")
		}
    arr.push(String(total-1))
%>
<!-- <a href="#"><%= offset %></a> -->
<% } %>

<div class="wrap-pagination">
  <%= offset %>
  <%= limit %>
  <%= total %>
  <div class="pagination">
    <ul>
      <li>
        <a href="<%= path %>&limit=<%=limit%>&offset=<%= offset > limit ? offset-limit : 0 %>" class="<%=offset > 0 ? '':'disable' %>">Trang trước</a>
      </li>
      <% for(index in arr){ %>
      <% if(arr[index]==="..."){ %>
      <li>
        <a class="<%= arr[index]==offset ? 'current' :'' %>" href="#"><%= arr[index] %></a>
      </li>
      <% }else{ %>
      <li>
        <a class="<%= arr[index]==offset ? 'current' :'' %>" href="<%= path %>&limit=<%=limit%>&offset=<%= arr[index] %>"><%= arr[index] %></a>
      </li>
      <% } } %>
      <li><a href="<%= path %>&limit=<%=limit%>&offset=<%= offset < (total-1)*limit ? offset + limit : (total-1) * limit %>" class="<%= offset < total-1 ? '':'disable' %>">Trang sau</a></li>
    </ul>
  </div>
</div>