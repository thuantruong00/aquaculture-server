<div class="col-md-12 col-sm-12 device-group item-<%=group._id %> pb-3">
  <div class="wrap-device-group">
    <%- include('../cms/setting.ejs',{id:group.info._id,type:"group", setting:setting}) %>
    <a href="#">
      <h4 class="group-name"><%=group.info.groupName %></h4>
    </a>
    <br>
    <div class="row">
      <% 
if(group.devices && group.devices.length > 0) {
	for(const device of group.devices) { 
		if(device && device.deviceModel) { %>
      <%- include(`../overview-device-templates/${device.deviceModel.template}.ejs`, {device: device, setting:false}) %>
      <% } } } %>
    </div>
  </div>
</div>