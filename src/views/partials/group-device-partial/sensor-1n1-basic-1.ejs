<div class="col-6 my-2 x-item-<%= device._id %>">
  <div class="device-item">
    <div class="wrap-device-item">
      <%- include('./setting.ejs',{id:device._id,type:"device", setting:setting}) %>
      <a href="#" class="wrap-name">
        <h6 class="name link-icon"><%= device.name %></h6>
      </a>

      <%
      if(device.deviceModel.fields.length>0){
        for(const item of device.deviceModel.fields){ %>
      <div class="sensor-value x-key-<%= item.key %>"><span class="value">


          <%= device?.latestRecord 
        ? (device.latestRecord.values.find(value => value.key == item.key)?.value ?? "-") 
        : "-" 
          %>



        </span><span class="unit"><%=item.unit %></span></div>
      <%
        }
      }
      %>

      <div class="updated-at"><small><i><%= device?.latestRecord ? new Date(device.latestRecord.timestamp).toLocaleTimeString('en-GB') :"--/--" %></i></small></div>
    </div>
  </div>
</div>