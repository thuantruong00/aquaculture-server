<div class="container modal-id ">
  <div class="gap-sm"></div>
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="wrap-title">
        <div class="title">Sửa hành động</div>
      </div>
      <div class="my-form #form_id">
        <div class="wrap-my-form">
          <form action="/dashboard/automatic/action-detail/<%=action._id %>" method="post">
            <label for="name">Tên</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <input name="name" type="text" required value="<%=action.name %>" placeholder="Tên" class="w-100" id="name">
            </div>
            <div class="gap-xs"></div>
            <div class="wrap-input">
              <select name="status" required id="status" class="w-50">
                <% if(status.length>0){ %>
                <% for(item of status){ %>
                <option value="<%=item %>" <%=action.status==item?"selected":"" %>><%=item %></option>
                <% } } %>
              </select>
              <label for="status">Trạng thái</label>
            </div>

            <label for="description">Mô tả</label>
            <div class="gap-xs"></div>
            <div class="wrap-input">
              <input name="description" id="description" type="text" value="<%=action.description %>" placeholder="Mô tả / có thể để trống" class="w-100">
            </div>

            <div class="gap-sm"></div>

            <!-- ====================== -->
            <div class="condition">
              <div class="wrap-condition formCondition">
                <div class="condition-row">
                  <% if(action.steps.length>0){ %>
                  <% for(step of action.steps){ %>
                  <div class="row row-div">
                    <div class="col-5">
                      <label>Thiết bị / Giá trị</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <select name="device" required class="w-100">
                          <% if(devices.length>0){ %>
                          <% for(item of devices){ %>
                          <option value="<%=item.deviceId+'|'+item.key %>" <%= String(step.deviceId) == String(item.deviceId) && step.key == item.key ? "selected":"" %> ><%=item.label %></option>
                          <% } } %>
                        </select>
                      </div>
                    </div>
                    <div class="col-5">
                      <label>Giá trị1</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <input name="value" type="number" step="0.1" min="0" max="100" value="<%= step.value %>" required placeholder="Giá trị" class="w-100">
                      </div>
                    </div>
                    <div class="col-2 align-content-center">
                      <a href="#" data-condition=".formCondition" class="btn-delete-condition">Xoá</a>
                    </div>
                  </div>
                  <% } %>
                  <% } else{ %>

                  <div class="row row-div">
                    <div class="col-5">
                      <label>Thiết bị</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <select name="device" required class="w-100">
                          <% if(devices.length>0){ %>
                          <% for(item of devices){ %>
                          <option value="<%=item.deviceId+'|'+item.key %>"><%=item.label %></option>
                          <% } } %>
                        </select>
                      </div>
                    </div>

                    <div class="col-5">
                      <label>Giá trị</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <input name="value" type="number" step="0.1" min="0" max="100" required placeholder="Giá trị" class="w-100">
                      </div>
                    </div>

                    <div class="col-2 align-content-center">
                      <a href="#" data-condition=".formCondition" class="btn-delete-condition">Xoá</a>
                    </div>
                  </div>
                  <% } %>
                </div>

                <div class="wrap-btn">
                  <div class="gap-xs"></div>
                  <a href="#" onclick="addCondition('.formCondition')" class="btn-add-condition">Thêm +</a>
                </div>
              </div>
            </div>
            <div class="gap-md"></div>
            <!-- ====================== -->

            <div class="submit">
              <button class="submit-btn">Lưu</button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="gap-md"></div>
</div>