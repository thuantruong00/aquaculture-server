<div class="container modal-id ">
  <div class="gap-sm"></div>
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="wrap-title">
        <div class="title">Sửa kịch bản</div>
      </div>
      <div class="my-form #form_id">
        <div class="wrap-my-form">
          <form action="/dashboard/automatic/scene-detail/<%=scene.id %>" method="post">
            <label for="name">Tên</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <input name="name" type="text" value="<%=scene.name %>" required placeholder="Tên" class="w-100" id="name">
            </div>
            <div class="gap-xs"></div>
            <div class="wrap-input">
              <select name="status" required id="status" class="w-50">
                <% if(status.length>0){ %>
                <% for(item of status){ %>
                <option value="<%=item %>" <%=scene.status==item?"selected":"" %>><%=item %></option>
                <% } } %>
              </select>
              <label for="status">Trạng thái</label>
            </div>

            <label for="group">Nhóm</label>
            <div class="gap-xs"></div>
            <div class="wrap-input">
              <input name="group" id="group" type="text" value="<%=scene.description %>" placeholder="Nhóm / có thể để trống" class="w-100">
            </div>

            <div class="gap-sm"></div>
            <div class="wrap-input required">
              <select name="logic" required id="logic" class="w-50">
                <% if(logicOperator.length>0){ %>
                <% for(item of logicOperator){ %>
                <option value="<%=item.value %>" <%= item.value == scene.logic ? "selected":"" %>><%=item.label %></option>
                <% } } %>
              </select>
              <label for="logic">Loại Logic</label>
            </div>
            <div class="gap-sm"></div>
            <!-- ====================== -->
            <div class="condition">
              <div class="wrap-condition formCondition">
                <div class="condition-row">
                  <% if(scene.conditions.length>0){ %>
                  <% for(condition of scene.conditions){ %>
                  <div class="row row-div">
                    <div class="col-5">
                      <label>Thiết bị</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <select name="device" required class="w-100">
                          <% if(devices.length>0){ %>
                          <% for(item of devices){ %>
                          <option value="<%=item.deviceId+'|'+item.key %>" <%= String(condition.device) == String(item.deviceId) && condition.key == item.key ? "selected":"" %>><%=item.label %></option>
                          <% } } %>
                        </select>
                      </div>
                    </div>

                    <div class="col-3">
                      <label>So sánh</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <select name="operator" required class="w-100">
                          <% if(comparisonOperators.length>0){ %>
                          <% for(item of comparisonOperators){ %>
                          <option value="<%=item.value %>" <%=condition.operator==item.value?"selected":"" %>><%=item.label %></option>
                          <% } } %>
                        </select>
                      </div>
                    </div>

                    <div class="col-3">
                      <label>Giá trị</label>
                      <div class="gap-xs"></div>
                      <div class="wrap-input required">
                        <input name="value" type="number" value="<%=condition.value %>" step="0.1" min="0" max="100" required placeholder="Giá trị" class="w-100">
                      </div>
                    </div>

                    <div class="col-1 align-content-center">
                      <a href="#" data-condition=".formCondition" class="btn-delete-condition">Xoá</a>
                    </div>
                  </div>

                  <% } %>
                  <% } %>

                </div>

                <div class="wrap-btn">
                  <div class="gap-xs"></div>
                  <a href="#" onclick="addCondition('.formCondition')" class="btn-add-condition">Thêm +</a>
                </div>
              </div>
            </div>


            <div class="gap-md"></div>
            <div class="wrap-input">
              <select name="action" id="action" class="w-50">
                <% if(actions && actions.length > 0){ %>
                <% for(item of actions){ %>
                <option value="<%=item._id %>" <%=scene.actions && scene.actions.length > 0 && String(scene.actions[0]._id) == String(item._id) ? "selected":"" %>><%=item.name %></option>
                <% } } else { %>
                <option value="">Trống - chưa có hành động nào được tạo</option>
                <% } %>

              </select>
              <label for="action">Chọn hành động</label>
              <div class="gap-sm"></div>
              <a href="#" class="px-3">Tạo hành động (nếu chưa có)</a>
            </div>

            <div class="gap-sm"></div>
            <div class="wrap-input required">
              <select name="notiGroup" required id="notiGroup" class="w-50">
                <option value="none">Không nhận thông báo</option>
                <% if(notiGroup.length>0){ %>
                <% for(item of notiGroup){ %>
                <option value="<%=item._id %>" <%= String(item._id) == String(scene.notifications) ? "selected":"" %>><%=item.name %></option>
                <% } } %>
              </select>
              <label for="logic">Chọn nhóm nhận thông báo</label>
            </div>

            <!-- ====================== -->
            <div class="submit">
              <button class="submit-btn">Lưu</button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="gap-md"></div>
</div>