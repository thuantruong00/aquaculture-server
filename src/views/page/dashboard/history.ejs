<div class="container modal-id ">
  <div class="gap-xs"></div>
  <div class="chart-wrap">
    <div class="my-form form-chart-1">
      <div class="wrap-my-form py-3">
        <div class="row">
          <div class="col-lg-6 col-12">
            <label for="template-device-group">Danh sách giá trị cảm biến</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <select name="device" id="template-device-group" class="w-100">
                <% if(devices.length>0){
                  for(const item of devices) { %>
                <option value="<%=item.deviceId%>:<%=item.key%>" <%= String(item.deviceId) == deviceId && String(item.key) == key ? "selected" :"" %>><%=item.label%></option>
                <% } } else{ %>
                <option>Không có thiết bị nào để chọn .</option>
                <% } %>
              </select>
            </div>
          </div>
          <div class="col-lg-3 col-12">
            <label for="">Ngày</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <input type="date" name="date" value="<%= date %>" class="w-100">
            </div>
          </div>
          <div class="col-lg-3">
            <div class="gap-xs d-md-block d-none"></div>
            <div class="gap-xs d-md-block d-none"></div>
            <div class="submit">
              <button class="submit-btn" onclick="getRecordsData('.form-chart-1')">Xem</button>
            </div>

          </div>
        </div>

      </div>
    </div>


    <div class="gap-sm"></div>
    <div class="col-12">
      <div class="base-list sensor-record-list">
        <div class="wrap-box">
          <ul class="">
            <li class="d-flex">
              <span>Stt</span>
              <span class="device-name">Ngày</span>
              <span class="device-name">Giờ</span>
              <span>Loại</span>
              <span>Giá trị</span>
            </li>

            <% if(records.length>0){ %>
            <% for(index in records){ %>
            <li class="d-flex">
              <span><%=index %></span>
              <span class="device-name short-text">
                <%=new Date(records[index].t).toLocaleDateString('en-GB') %>
              </span>
              <span class="device-name short-text">
                <%=new Date(records[index].t).toLocaleTimeString('en-GB') %>
              </span>
              <span class="short-text"><%=t("sensors."+records[index].key) %></span>
              <span class="short-text"><%=records[index].value %></span>
            </li>
            <% } } %>

          </ul>
        </div>
      </div>
      <%
      const path ="/dashboard/history?deviceId="+ deviceId +"&key="+key+"&date="+date
      %>
      <%- include('../../partials/cms/pagination.ejs',{ offset , limit, total, path}) %>
    </div>
  </div>
   <div class="gap-lg"></div>
</div>