
  <div class="container mt-5 modal-id ">
    <div class="col-12 d-flex flex-row-reverse ">
      <div class="box-temp col-7">
          <div class="d-flex justify-content-between">
            <div class="d-flex">Average temperature:<p class="ml-1" style="width: 60px;" id="average-value">°C</p></div>
            <div class="ml-3 d-flex">Limit temperature: <p class="ml-1 mr-3"  style="width: 60px;" id="limit-value"><%=dataLimit%>°C</p></div>
          </div>
          <!-- <div class="d-flex flex-row-reverse mt-3">
          <div class=" d-none font-last-update" >Last updated: <p class="ml-1" id="last-time-value">12h30</p></div>
        </div> -->
      </div>
    </div>
    <div class="col-12 ">
        <% for(const item of array) { %>
            <div class="bg-wrap-form ">
                <div class="list-row tag-content">
                  <div class="wrap-content d-flex justify-content-between align-items-center">
                      <label id="label-text-<%=item[0]?.idPort %>" for="inp0">ID device: <%= item[0]?.idPort ?item[0]?.idPort: NaN   %></p></label>
                      <div>
                        <button class=" btn btn-manual" onclick="handleControl('manual')">Manual</button>
                        <button class=" btn btn-auto ml-2 mr-2 btn-primary" onclick="handleControl('auto')">Automatic</button>
                        <button class=" btn btn-auto  btn-light" onclick="handleRecover()">Recover</button>
                      </div>
                    </div>
                    <div class="extension d-flex flex-wrap" id="section-id-<%=item[0]?.idPort %>">
                        <% for(const itemData of item) { %>
                        
                           <div class="col-6 mt-3 mb-3 <%=item[0]?.idPort %> " order="<%=item[0]?.order%>">
                                  <div class="col-12 p-2 overlay  wrapper-port" id="port-<%=item[0]?.idPort%>-<%=itemData.order%> ">
                                    <%if(itemData.name=="") {%>
                                        <p class=" d-flex justify-content-center">Name</p>
                                    <%} else {%>
                                        <p class=" d-flex justify-content-center"><%=itemData.name%></p>
                                        <%}%>
                                     <div class="  mt-3 mb-3 ">
                                          <div class=" ">
                                           <div class="d-flex justify-content-center"> <label class="label-port d-flex"> <p class="value-brightness-<%=itemData._id%>-port1 ml-2"  id="port1-value-<%=item[0]?.idPort%>-<%=itemData.order%>"><%=itemData.port1%></p></label></div>
                                            <div class="d-flex justify-content-around align-items-center ">
                                                <button 
                                                disabled
                                                type="menu"  class="btn-control-down button-brightness justify-content-center btn-decrease-<%=itemData._id%>-port1 btn-control-port  align-items-center" disabled onclick="handleDecrease(`port1`,'<%=itemData.order%>','<%=item[0]?.idPort%>')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash-lg" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8" style="color: white;"/>
                                                      </svg>
                                                </button>
                                                        <input
                                                        disabled
                                                        type="range"
                                                        class="form-range ip-select-<%=itemData._id%> form-range-<%=itemData.colorPort1%>  port1-<%=item[0]?.idPort%>-<%=itemData.order%>"
                                                        min="0"
                                                        max="100"
                                                        step="1"
                                                        id="brightnessRange-<%=itemData._id%>-port1 port1-<%=item[0]?.idPort%>-<%=itemData.order%>"
                                                        value="<%=itemData.port1%>"
                                                        onchange="handleOnChangeInput('<%=itemData.order%>' ,'<%=itemData.idPort%>')"
                                                        oninput="onInput(this.value,`<%=itemData._id%>-port1` )"
                                                      />  
                                              <button
                                              disabled
                                              class="btn-control-up button-brightness btn-control-port"  onclick="handleIncrease(`port1`,'<%=itemData.order%>','<%=item[0]?.idPort%>')">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                                                    <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" style="color: white;"/>
                                                  </svg>
                                              </button>
                                            </div>     
                                            
                                        </div>
                                        <div class="  mt-3 mb-3 ">
                                            <div class=" ">
                                                <div class="d-flex justify-content-center"> <label class="label-port d-flex"><p class="value-brightness-<%=itemData._id%>-port2 ml-2" id="port2-value-<%=item[0]?.idPort%>-<%=itemData.order%>"><%=itemData.port2%></p></label></div>
    
                                              <div class="d-flex justify-content-around align-items-center ">
                                                <button 
                                                disabled
                                                type="menu"  class="btn-control-down button-brightness justify-content-center btn-decrease-<%=itemData._id%>-port1   align-items-center btn-control-port"  onclick="handleDecrease(`port2`,'<%=itemData.order%>','<%=item[0]?.idPort%>')">
    
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash-lg" viewBox="0 0 16 16" >
                                                        <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8" style="color: white;" />
                                                      </svg>
                                                  </button>
                                                          <input
                                                        disabled
  
                                                          type="range"
                                                          class="form-range ip-select-<%=itemData._id%> form-range-<%=itemData.colorPort2%>  port2-<%=item[0]?.idPort%>-<%=itemData.order%>"
                                                          min="0"
                                                          max="100"
                                                          step="1"
                                                          id="brightnessRange-<%=itemData._id%>-port2 port2-<%=item[0]?.idPort%>-<%=itemData.order%>"
                                                          value="<%=itemData.port2%>"
                                                        onchange="handleOnChangeInput('<%=itemData.order%>','<%=itemData.idPort%>')"
                                                        
                                                          oninput="onInput(this.value,`<%=itemData._id%>-port2` )"
                                                        />  
                                                <button 
                                                disabled
                                                class="btn-control-up button-brightness btn-control-port "  onclick="handleIncrease(`port2`,'<%=itemData.order%>','<%=item[0]?.idPort%>')">
                                                    <svg xmlns="http://www.w3.org/2000/svg"  width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                                                        <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" style="color: white;"/>
                                                      </svg>
                                                </button>
                                              </div>     
                                                <div class="d-flex justify-content-center flex-column align-items-center">
                                                    <button  onclick="handleSavePort('<%=itemData._id%>', '<%=item[0]?.idPort %>','<%=itemData.order%>')" data="<%=itemData._id%>,<%=item[0]?.idPort %>,<%=itemData.order%>" class="btn-save d-none btn btn-primary btn-<%=itemData._id%> ">Save</button>
                                                </div>
                                            </div>
                                          </div>
                                     </div>
                                   
                                     <div class="p-3">
                                         <div class="d-flex justify-content-between mb-1">
                                            <div>Temperature: <label id="value-temp-<%=itemData.idDevice%>"><%=itemData.valueTemperature%></label>°C</div>
                                            <div>Limit: <label id="value-temp-<%=itemData.idDevice%>"><%=dataLimit%></label>°C</div>
                                            <div>Humidity: <label id="value-humidity-<%=itemData.idDevice%>"><%=itemData.valueHumidity%></label></div>
                                         </div>
                                         <div class="d-flex justify-content-between  mb-1">
                                          <div>pH: <label id="value-ph-<%=itemData.idDevice%>"><%=itemData.valuePH%></label></div>
                                          <div>TDS: <label id="value-tds-<%=itemData.idDevice%>"><%=itemData.valueTds%></label></div>

                                      </div>
                                      <div class="d-flex justify-content-between  mb-1">
                                        <div>N: <label id="value-nitro-<%=itemData.idDevice%>"><%=itemData.valueNitro%></label></div>
                                        <div>P: <label id="value-phos-<%=itemData.idDevice%>"><%=itemData.valuePhos%></label></div>
                                        <div>K: <label id="value-pota-<%=itemData.idDevice%>"><%=itemData.valuePota%></label></div>
                                    </div>
                                     </div>
                                </div>
                           </div>
                        <%}%>
                    </div>
                </div>
                <div class="d-flex justify-content-center mt-2"><button  class="btn d-none btn-primary btn-save-all" onclick="savePort()">Save</button></div>
            </div>

        <%}%>
    </div>
  </div>