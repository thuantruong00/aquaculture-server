<div class="container modal-id">
  <div class="gap-sm"></div>
  <div class="row align-items-center">
    <div class="col-3">
      <div class="wrap-form">
        <form action="/notification-setting/new-group/" method="get">
          <button class="px-3 py-1">+ Tạo nhóm mới</button>
        </form>
      </div>
    </div>
    <div class="col-6">
      <div class="wrap-title">
        <div class="title">Danh sách nhóm nhận thông báo</div>
      </div>
    </div>
  </div>


  <div class="base-list pending-devices-list pt-2">
    <div class="wrap-box">
      <ul>
        <li class="d-flex header-row">
          <span>Stt</span>
          <span class="device-name">Tên</span>
          <span>Trạng thái</span>
          <span>Mô tả</span>
          <span class="action">Hành động</span>
        </li>
        <% if(groups.length>0) { for (const index in groups) { %>
        <li class="item-<%=groups[index]._id %> d-flex">
          <span><%= index %></span>
          <span class="device-name"><%= groups[index].name %></span>
          <span class="short-text"><%= groups[index].enabled ? "Kích hoạt" : "Khoá" %></span>
          <span class="short-text"><%= groups[index].description %></span>
          <span class="action wrap-action-btn">
            <a href="/notification-setting/group-detail/<%=groups[index]._id %>">
              <button class="primary-btn">Sửa</button>
            </a>
            <a href="/notification-setting/delete-group/<%= groups[index]._id %>" class="primary-btn delete-device-btn-style">Xoá ×</a>
          </span>
        </li>
        <% } } else { %>
        <p>Không có bất kì nhóm nào.</p>
        <% } %>
      </ul>
    </div>
  </div>
</div>