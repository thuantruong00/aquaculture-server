<div class="container modal-id ">
  <div class="gap-xs"></div>
  <div class="chart-wrap">
    <div class="my-form form-chart-1">
      <div class="wrap-my-form">
        <div class="row">
          <div class="col-lg-6 col-12">
            <label for="template-device-group">Danh sách giá trị cảm biến</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <select name="device" id="template-device-group" class="w-100">
                <% if(devices.length>0){
                  for(const item of devices) { %>
                <option value="<%=item.deviceId%>:<%=item.key%>" <%= String(item.deviceId) == deviceId && String(item.key) == key ? "selected" :"" %>><%=item.label%></option>
                <% } } else{ %>
                <option>Không có thiết bị nào để chọn .</option>
                <% } %>
              </select>
            </div>
          </div>
          <div class="col-lg-3 col-12">
            <label for="">Ngày</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <input type="date" name="date" value="<%= date %>" class="w-100">
            </div>
          </div>
          <div class="col-lg-3 col-12">
            <label for="">Khung thời gian</label>
            <div class="gap-xs"></div>
            <div class="wrap-input required">
              <input type="number" name="bucket" value="<%= bucket ? bucket : 10 %>" step="1" min="1" max="60" class="w-100">
            </div>
          </div>
        </div>
        <div class="submit">
          <button class="submit-btn" onclick="getChartData('.form-chart-1')">Xem</button>
        </div>
      </div>
    </div>



    <div class="gap-sm"></div>
    <div class="chart-bg">
      <div id="chart"></div>
    </div>
    <div class="gap-xs"></div>
    <div class="controls">
      <button id="btnRefresh">Làm mới</button>
    </div>
  </div>
  <div class="gap-lg"></div>
</div>
<script>
  const seriesAvg = <%- seriesAvg %>;
  const seriesMin = <%- seriesMin %>;
  const seriesMax = <%- seriesMax %>;
</script>