<div class="gap-md"></div>
<div class="container">
  <div class="wrap-box p-3 intro-card">
    <div class="row align-items-center">
      <div class="col-md-3 text-center mb-3 mb-md-0">
        <div class="intro-logo">
          <img src="<%= intro?.logoUrl %>" alt="<%= intro?.title %>" style="max-width: 140px; width: 100%; height: auto;" />
        </div>
      </div>
      <div class="col-md-9">
        <h2 class="mb-2 intro-title"><%= intro?.title %></h2>
        <div class="gap-xs"></div>
        <p class="mb-2 intro-desc"><%= intro?.description %></p>
        <div class="gap-xs"></div>
        <div class="intro-badges">
          <span class="intro-badge">Version: <%= intro?.version %></span>
          <span class="intro-badge">Build: <%= intro?.build %></span>
        </div>
        <div class="gap-xs"></div>
        <p class="mb-2 intro-desc text-right" style="font-size: 13px;"><i>Powered by EdgeOn</i></p>
      </div>
    </div>
  </div>
</div>