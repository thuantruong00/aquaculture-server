<div class="container modal-id">
  <div class="control-devices-list pt-2">
    <div class="wrap-box">
      <div class="row">


        <% if(deviceByGroup.length > 0) { %>
        <% for(const group of deviceByGroup) { %>
        <%- include(`../../partials/group-templates/${group.template}.ejs`, {group: group, setting:false}) %>
        <% } %>
        <% } %>

        <!--  -->
      </div>
      <div class="row without-group-device">
        <% if(withoutGroupDevice.length>0){ 
        for(const item of withoutGroupDevice){ 
          if(item.deviceModel?.template){ %>
          <%- include(`../../partials/device-templates/${item.deviceModel.template}.ejs`,{device:item, setting:false}) %>

        <% } } } %>
      </div>
    </div>
  </div>
</div>