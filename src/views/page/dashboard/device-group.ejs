<div class="gap-sm"></div>
<div class="row justify-content-center">
  <div class="col-8">
    <div class="wrap-title">
      <div class="title">Tạo nhóm mới</div>
    </div>
    <div class="my-form create-device-group" id="create-device-group">
      <div class="wrap-my-form">
        <form action="/custom-ui/create-group" method="post">
          <div class="wrap-input required">
            <input name="groupName" type="text" required placeholder="Tên nhóm" class="w-100">
          </div>
          <div class="wrap-input">
            <select name="template" id="template-device-group" class="w-50" required>
              <% for(const opt of templates){ %>
              <option value="<%=opt %>"><%=opt %></option>
              <% } %>
            </select>
            <label for="template-device-group">Template</label>
          </div>
          <div class="wrap-input">
            <input name="groupDescription" type="text" placeholder="Mô tả / Có thể để trống" class="w-100">
          </div>

          <div class="wrap-input">
            <input type="text" name="zone" placeholder="Chọn khu vực / Có thể để trống" class="w-100">
          </div>
          <div class="submit">
            <button class="submit-btn">Submit</button>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>