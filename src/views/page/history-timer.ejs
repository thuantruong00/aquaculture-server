<div class="col-12 mt-4 modal-id">
  <table class="table table-hover">
    <tr>
      <th>idDevice</th>
      <th>Name port</th>
      <th>Port 1</th>
      <th>Port 2</th>
      <th>Time</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
    <%for(const item of arrayTimer) {%>
    <tr class="id-device-<%=item._id%> ">
      <td><%=item.idDevice%></td>
      <td><%=item.valueName%></td>
      <td><%=item.valuePort1%></td>
      <td><%=item.valuePort2%></td>
      <td><%=item.valueHour%>:<%=item.valueMinute%></td>
 
      <td class="id-status-<%=item._id%>"><%=item.status%></td>
      <td>
        <btn class="btn btn-danger" onclick="handleDeleteTimer('<%=item._id%>')">Delete</btn>
        <btn class="btn btn-warning" onclick="handleChangeStatus('<%=item._id%>','<%=item.status%>')">Change</btn>
      </td>
    </tr>
    <%}%>
  </table>
</div>
