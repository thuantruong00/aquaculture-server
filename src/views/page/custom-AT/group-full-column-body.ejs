<div class="col-md-12 col-sm-12 device-group only-body item-<%=group._id %> pb-3">
  <div class="wrap-device-group">
    <%
    const groupDevices = group?.devices || [];
    const scd40Sensors = groupDevices.filter((device) => {
      return device?.deviceModel?.name === "scd40-relay-wifi";
    });
    const scd40 = {
      modelName: "scd40-relay-wifi",
      devices: scd40Sensors,
    };
    %>
    <div class="row custom-at-workspace">
      <% if(groupDevices.length > 0) {
        for(const device of groupDevices) { 
        if(device && device.deviceModel && device.deviceModel.name === "led-bar-2-line-AT") { %>
        <%- include(`./${device.deviceModel.template}.ejs`, {
          device: device,
          setting:false,
          scd40: scd40,
        }) %>
        <% } %>

      <% } } %>
    </div>
  </div>
</div>
