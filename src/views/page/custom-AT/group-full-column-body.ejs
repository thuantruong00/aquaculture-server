<div class="col-md-12 col-sm-12 device-group only-body item-<%=group._id %> pb-3">
  <div class="wrap-device-group">
    <div class="row">
      <% 
if(group.devices && group.devices.length > 0) {
	for(const device of group.devices) { 
		if(device && device.deviceModel) { %>
      <%- include(`./${device.deviceModel.template}.ejs`, {device: device, setting:false}) %>
      <% } } } %>
    </div>
  </div>
</div>