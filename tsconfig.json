{
  "compilerOptions": {
    "target": "ES2016",
    "lib": [
      "esnext"
    ],
    "module": "commonjs",
    "sourceMap": true,
    "outDir": "./public",
    "newLine": "lf",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "~/*": [
        "src/*"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "resolveJsonModule": true,
    "allowJs": true
  },
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ],
    "files": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "./node_modules"
  ]
}